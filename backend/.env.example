# Copy to backend/.env and set the database connection values for your local environment.
DB_HOST=localhost
DB_NAME=your_local_database
DB_USER=your_local_database_user
DB_PASSWORD=replace_with_local_database_password
PORT=5000
JWT_SECRET=replace_with_a_random_secret
GROQ_API_KEY=replace_with_api_key_if_used

# Used only by: node backend/scripts/createAdmin.js
ADMIN_NAME=replace_with_admin_name
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace_with_a_strong_password
